# Development Environment Variables - EXAMPLE
# =============================================
# Copy this file to .env and update the values for your environment.
# The .env file is gitignored and should not be committed.

# API Base URL (without /api/v1 prefix)
# This is where your FastAPI backend is running
VITE_API_BASE_URL=http://127.0.0.1:5000

# WebSocket Base URL (without the client ID)
# The app will append /{client_id} to this URL
VITE_WS_BASE_URL=ws://127.0.0.1:5000/ws
